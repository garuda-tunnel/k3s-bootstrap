# Managed by k3s-bootstrap
[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
# Upstream value: no systemd start timeout. The bounded wait is owned by the
# k3s role (tasks/main.yml) and the readiness role (readiness_timeout), not
# the unit.
TimeoutStartSec=0
# This unit loads no EnvironmentFile on purpose: the module owns every
# k3s setting through config.yaml, and an environment file left behind
# by an earlier upstream install (for example K3S_KUBECONFIG_MODE)
# would override module-owned keys.
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s {{ "agent" if node_type == "agent" else "server" }}
