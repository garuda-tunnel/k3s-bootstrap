# Minimal stand VM for the module test tier: the fixture copies
# this file verbatim into a per-stand directory (one Vagrant machine per
# stand) and drives it with `vagrant up` / `vagrant destroy -f`. Per-stand
# values arrive through the environment because the template is unmodified.
# Only `vagrant up` needs them: manual cleanup (`vagrant destroy -f`,
# `vagrant status`) must work from a fresh shell without the fixture env.
MACHINE = ENV.fetch("K3SB_MACHINE_NAME", nil)
PUBKEY = ENV.fetch("K3SB_PUBKEY", nil)
# Box selection is shared with the molecule scenarios (K3SB_BOX /
# K3SB_BOX_VERSION, see molecule/README.md); defaults keep a plain
# `vagrant up` working without them.
BOX = ENV.fetch("K3SB_BOX", "cloud-image/ubuntu-26.04")
BOX_VERSION = ENV.fetch("K3SB_BOX_VERSION", "20260927.0.0")
if ARGV.include?("up") && (MACHINE.nil? || PUBKEY.nil?)
  abort "K3SB_MACHINE_NAME and K3SB_PUBKEY are required for `vagrant up`"
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_version = BOX_VERSION
  config.vm.hostname = MACHINE if MACHINE
  # The fixture uploads everything through the module's provisioners.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider :libvirt do |lv|
    lv.memory = 2048
    lv.cpus = 2
    # Keep the default (localhost VNC + cirrus): graphics_type "none" drops
    # the video device, and Debian 13's GRUB reset-loops without one.
  end

  # The module bootstraps through the box's sudo user (`vagrant`); this
  # key is the module's ssh_private_key_file, authorized for the vagrant
  # user here and for the module's ssh_user once the access tag has run.
  config.vm.provision "shell", inline: <<-SHELL
    grep -qF '#{PUBKEY}' /home/vagrant/.ssh/authorized_keys || echo '#{PUBKEY}' >> /home/vagrant/.ssh/authorized_keys
  SHELL
end
